# GhostGuard Backend Configuration

# Database
DATABASE_PATH=data/db/ghostguard.db


IDENTITY_PROVIDER=mock


DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io

# LLM Provider: "together" / "gemini" / "openai" / "mock"
LLM_PROVIDER=mock
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
GEMINI_API_KEY=
OPENAI_API_KEY=

# PII Masking
PII_HMAC_SECRET=ghostguard-demo-secret-change-in-prod

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Email / SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ghostguard@sterlingdist.com

# Odoo (optional)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
